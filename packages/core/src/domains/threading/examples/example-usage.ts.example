/**
 * Run all examples
 */
export async function runAllExamples() {
  console.log('=== Threading System Examples ===\n');

  // 1. Initialize
  console.log('1. Initializing threading system...');
  const logger = initializeThreadingSystem();

  // 2. Test pattern detection
  console.log('\n2. Testing pattern detection...');
  await testPatternDetection();

  // 3. Manual tracking
  console.log('\n3. Testing manual tracking...');
  try {
    await manualTrackingExample();
  } catch (error) {
    console.log('External API call skipped (expected in test environment)');
  }

  // 4. Flush logs
  console.log('\n4. Flushing logs...');
  await logger.flush();

  console.log('\n✅ All examples completed!');
}

// Run examples if executed directly
if (require.main === module) {
  runAllExamples().catch(console.error);
}
